<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- ============================================================
     call.xml
     UAC que faz chamadas SIP com suporte a autenticação Digest e áudio RTP.
     Fluxo com branching dinâmico:
       INVITE -> se 401/407: ACK -> INVITE com auth -> 200 OK -> ACK -> RTP -> BYE
              -> se 200 OK direto: ACK -> RTP -> BYE
     ============================================================ -->

<scenario name="UAC chamada com audio RTP">

  <Global variables="domain,user,dest"/>

  <!-- 1) INVITE inicial -->
  <send retrans="500">
    <![CDATA[

      INVITE sip:[$dest]@[$domain] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      Max-Forwards: 70
      From: "[$user]" <sip:[$user]@[$domain]>;tag=[call_number]
      To: <sip:[$dest]@[$domain]>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      Contact: <sip:[$user]@[local_ip]:[local_port];transport=[transport]>
      User-Agent: SIPp-Load-Tester-Pro
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp [call_number] [call_number] IN IP[local_ip_type] [local_ip]
      s=SIPp-Load-Tester-Pro
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8 0 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15
      a=sendrecv

    ]]>
  </send>

  <!-- Respostas ao primeiro INVITE -->
  <recv response="100" optional="true"/>
  <recv response="180" optional="true"/>
  <recv response="183" optional="true"/>
  <recv response="407" auth="true" optional="true" next="send_auth"/>
  <recv response="401" auth="true" optional="true" next="send_auth"/>
  <recv response="200" rtd="true" next="call_connected"/>

  <!-- 2) Branch de Autenticação Digest (quando exigido pelo PBX) -->
  <label id="send_auth"/>
  <send>
    <![CDATA[

      ACK sip:[$dest]@[$domain] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      Max-Forwards: 70
      From: "[$user]" <sip:[$user]@[$domain]>;tag=[call_number]
      To: <sip:[$dest]@[$domain]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Content-Length: 0

    ]]>
  </send>

  <send retrans="500">
    <![CDATA[

      INVITE sip:[$dest]@[$domain] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      Max-Forwards: 70
      From: "[$user]" <sip:[$user]@[$domain]>;tag=[call_number]
      To: <sip:[$dest]@[$domain]>
      Call-ID: [call_id]
      CSeq: 2 INVITE
      Contact: <sip:[$user]@[local_ip]:[local_port];transport=[transport]>
      [authentication]
      User-Agent: SIPp-Load-Tester-Pro
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp [call_number] [call_number] IN IP[local_ip_type] [local_ip]
      s=SIPp-Load-Tester-Pro
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8 0 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15
      a=sendrecv

    ]]>
  </send>

  <recv response="100" optional="true"/>
  <recv response="180" optional="true"/>
  <recv response="183" optional="true"/>
  <recv response="200" rtd="true"/>

  <!-- 3) Ponto de convergência: Chamada Estabelecida (200 OK) -->
  <label id="call_connected"/>
  <send>
    <![CDATA[

      ACK sip:[$dest]@[$domain] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      Max-Forwards: 70
      From: "[$user]" <sip:[$user]@[$domain]>;tag=[call_number]
      To: <sip:[$dest]@[$domain]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 2 ACK
      Content-Length: 0

    ]]>
  </send>

  <!-- 4) Playback de Áudio PCAP e Duração -->
  <nop>
    <action>
      <exec play_pcap_audio="@@PCAP_FILE@@"/>
    </action>
  </nop>

  <pause distribution="uniform"
         min="@@DURACAO_MIN_MS@@" max="@@DURACAO_MAX_MS@@"/>

  <!-- 5) Finalização da Chamada -->
  <send retrans="500">
    <![CDATA[

      BYE sip:[$dest]@[$domain] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      Max-Forwards: 70
      From: "[$user]" <sip:[$user]@[$domain]>;tag=[call_number]
      To: <sip:[$dest]@[$domain]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 3 BYE
      Content-Length: 0

    ]]>
  </send>

  <recv response="200" crlf="true"/>

  <ResponseTimeRepartition value="10, 20, 30, 40, 50, 100, 150, 200, 500, 1000"/>
  <CallLengthRepartition value="10000, 15000, 20000, 25000, 30000"/>

</scenario>
