<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- ============================================================
     call.xml
     UAC que faz uma chamada COM autenticacao digest e AUDIO REAL (RTP).
     Fluxo:
       INVITE -> 401/407 (auth) -> ACK -> INVITE(auth) ->
       100/180/183 -> 200 OK -> ACK -> toca audio (PCAP) ->
       segura a chamada -> BYE -> 200 OK
     O audio e enviado a partir de um arquivo PCAP (G.711 a-law).
     Rode com -l 100 para ter ate 100 chamadas SIMULTANEAS.
     ============================================================ -->

<scenario name="UAC chamada com audio RTP">

  <!-- Declara [$domain]; o valor vem de -set domain <dominio> no run.sh. -->
  <Global variables="domain,user,dest"/>

  <!-- 1) INVITE inicial (sem auth) -->
  <send retrans="500">
    <![CDATA[

      INVITE sip:[$dest]@[$domain] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      Max-Forwards: 70
      From: "[$user]" <sip:[$user]@[$domain]>;tag=[call_number]
      To: <sip:[$dest]@[$domain]>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      Contact: <sip:[$user]@[local_ip]:[local_port];transport=[transport]>
      User-Agent: SIPp-L5-Test
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp [call_number] [call_number] IN IP[local_ip_type] [local_ip]
      s=SIPp-L5-Test
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8 0 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15
      a=sendrecv

    ]]>
  </send>

  <recv response="100" optional="true"/>

  <!-- 2) Desafio de autenticacao (401 no chan_pjsip, 407 em alguns cenarios) -->
  <recv response="407" auth="true" optional="true"/>
  <recv response="401" auth="true"/>

  <!-- 3) ACK ao desafio -->
  <send>
    <![CDATA[

      ACK sip:[$dest]@[$domain] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      Max-Forwards: 70
      From: "[$user]" <sip:[$user]@[$domain]>;tag=[call_number]
      To: <sip:[$dest]@[$domain]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Content-Length: 0

    ]]>
  </send>

  <!-- 4) INVITE com credenciais (CSeq 2) -->
  <send retrans="500">
    <![CDATA[

      INVITE sip:[$dest]@[$domain] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      Max-Forwards: 70
      From: "[$user]" <sip:[$user]@[$domain]>;tag=[call_number]
      To: <sip:[$dest]@[$domain]>
      Call-ID: [call_id]
      CSeq: 2 INVITE
      Contact: <sip:[$user]@[local_ip]:[local_port];transport=[transport]>
      [authentication]
      User-Agent: SIPp-L5-Test
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=sipp [call_number] [call_number] IN IP[local_ip_type] [local_ip]
      s=SIPp-L5-Test
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8 0 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15
      a=sendrecv

    ]]>
  </send>

  <recv response="100" optional="true"/>
  <recv response="180" optional="true"/>
  <recv response="183" optional="true"/>

  <!-- 5) Chamada atendida -->
  <recv response="200" rtd="true"/>

  <!-- 6) ACK final -->
  <send>
    <![CDATA[

      ACK sip:[$dest]@[$domain] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      Max-Forwards: 70
      From: "[$user]" <sip:[$user]@[$domain]>;tag=[call_number]
      To: <sip:[$dest]@[$domain]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 2 ACK
      Content-Length: 0

    ]]>
  </send>

  <!-- 7/8) AUDIO + duracao da chamada.
       ATENCAO: este e um TEMPLATE. O run.sh substitui @@DURACAO_MIN_MS@@ e
       @@DURACAO_MAX_MS@@ e gera o call.xml final. Nao edite o call.xml
       diretamente - ele e sobrescrito a cada execucao.

       A duracao vem do <pause distribution="uniform">, que sorteia em
       MILISSEGUNDOS e garante o range exato. Nao usamos contador +
       <test>/<sample> para isso: 'sample' produz DOUBLE, e comparar um
       contador inteiro com float via variable2 nao termina de forma
       confiavel - era a causa de chamadas estourando o range. -->
  <nop>
    <action>
      <exec play_pcap_audio="@@PCAP_FILE@@"/>
    </action>
  </nop>

  <pause distribution="uniform"
         min="@@DURACAO_MIN_MS@@" max="@@DURACAO_MAX_MS@@"/>

  <!-- 9) Encerra a chamada -->
  <send retrans="500">
    <![CDATA[

      BYE sip:[$dest]@[$domain] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      Max-Forwards: 70
      From: "[$user]" <sip:[$user]@[$domain]>;tag=[call_number]
      To: <sip:[$dest]@[$domain]>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: 3 BYE
      Content-Length: 0

    ]]>
  </send>

  <recv response="200" crlf="true"/>

  <ResponseTimeRepartition value="10, 20, 30, 40, 50, 100, 150, 200, 500, 1000"/>
  <CallLengthRepartition value="10000, 15000, 20000, 25000, 30000"/>

</scenario>
