# ============================================================
# SIPp Load Tester Pro - Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e preencha suas credenciais:
#   Windows CMD:        copy .env.example .env
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux / Git Bash:   cp .env.example .env
# ============================================================

# Alvo e Conexão SIP (PBX IP / Asterisk)
SIP_ASTERISK_IP=192.168.0.1
SIP_ASTERISK_PORT=5060
SIP_DOMAIN=192.168.0.1
SIP_TRANSPORT=u1

# Identidade e Autenticação Digest (RFC 3261)
SIP_RAMAL=1002
SIP_USUARIO_AUTH=1002
SIP_SENHA=sua_senha_secreta_aqui

# Parâmetros Opcionais de Rede Local
SIP_LOCAL_IP=
SIP_LOCAL_PORT=
SIP_MEDIA_PORT=6000

# Destino Padrão para Testes
SIP_DESTINO=22223333
